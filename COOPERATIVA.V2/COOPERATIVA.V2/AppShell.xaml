<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="COOPERATIVA.V2.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:COOPERATIVA.V2.Views"
    FlyoutBehavior="Disabled">

    <ShellContent
        Route="IncioViewsPage"
        ContentTemplate="{DataTemplate local:InicioViewsPage}" />

    <ShellContent
        Route="LoginViewsPage"
        ContentTemplate="{DataTemplate local:LoginViewsPage}" />

    <!-- Menú lateral de la cooperativa -->
    <FlyoutItem
        x:Name="MenuCooperativa"
        Title="Menú principal"
        IsVisible="False">

        <ShellContent
            Title="Inicio"
            Route="MenuViewsPage"
            ContentTemplate="{DataTemplate local:MenuPage}" />

        <ShellContent
            Title="Socios"
            Route="SociosViewsPage"
            ContentTemplate="{DataTemplate local:SociosViewsPage}" />

        <ShellContent
            Title="Ahorros"
            Route="AhorrosViewsPage"
            ContentTemplate="{DataTemplate local:AhorrosViewsPage}" />

        <ShellContent
            Title="Préstamos"
            Route="PrestamosViewsPage"
            ContentTemplate="{DataTemplate local:PrestamosViewsPage}" />

        <ShellContent
            Title="Pagos"
            Route="PagosViewsPage"
            ContentTemplate="{DataTemplate local:PagosViewsPage}" />

    </FlyoutItem>

</Shell>