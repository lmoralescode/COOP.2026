<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="COOPERATIVA.V2.AppShell"
    FlyoutBehavior="Flyout"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:COOPERATIVA.V2.Views">

    <ShellContent 
        Title="Inicio"
        Route="inicio"
        ContentTemplate="{DataTemplate local:InicioViewsPage}"
        IsVisible="True"/>

    <ShellContent Title="Login"
        Route="login"
        ContentTemplate="{DataTemplate local:LoginViewsPage}"
        IsVisible="True"/>

    <ShellContent Title="Registro"
        Route="registro"
        ContentTemplate="{DataTemplate local:RegistroViewsPage}" />


    <FlyoutItem
        x:Name="OpcionMenu"
        Title="Menú principal"
        Route="menu"
        IsVisible="True">
        <ShellContent
            ContentTemplate="{DataTemplate local:MenuPage}" />
    </FlyoutItem>




</Shell>
