<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="COOPERATIVA.V2.AppShell"
    FlyoutBehavior="Flyout"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:COOPERATIVA.V2.Views">


    <ShellContent
        Route="InicioViewsPage"
        ContentTemplate="{DataTemplate local:InicioViewsPage}"
        Shell.FlyoutItemIsVisible="False" />

    <ShellContent
        Route="LoginViewsPage"
        ContentTemplate="{DataTemplate local:LoginViewsPage}"
        Shell.FlyoutItemIsVisible="False" />

</Shell>
