<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="COOPERATIVA.V2.Views.LoginViewsPage"
             BackgroundColor="#F3F8F4"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>

        <Color x:Key="VerdePrincipal">#087443</Color>
        <Color x:Key="VerdeOscuro">#064D32</Color>
        <Color x:Key="VerdeClaro">#E3F3E9</Color>
        <Color x:Key="TextoOscuro">#183B2B</Color>

    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">

            <VerticalStackLayout Spacing="0">

                <!-- ENCABEZADO -->
                <Grid BackgroundColor="{StaticResource VerdeOscuro}"
                      Padding="25,35,25,65">

                    <VerticalStackLayout Spacing="10">

                        <Label Text="COOPERATIVA"
                               FontSize="13"
                               CharacterSpacing="3"
                               FontAttributes="Bold"
                               TextColor="#B9E5CC"
                               HorizontalOptions="Center"/>

                        <Label Text="Bienvenido de nuevo"
                               FontSize="27"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"/>

                        <Label Text="Accede a tu espacio financiero"
                               FontSize="14"
                               TextColor="#D8EFE1"
                               HorizontalOptions="Center"/>

                    </VerticalStackLayout>

                </Grid>

                <!-- TARJETA DE ACCESO -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 28"
                        Margin="20,-40,20,20"
                        Padding="22">

                    <VerticalStackLayout Spacing="18">

                        <!-- LOGO -->
                        <Border BackgroundColor="#F0F8F2"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                Padding="10">

                            <Image Source="logocoopv2.png"
                                   HeightRequest="125"
                                   WidthRequest="230"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"/>

                        </Border>

                        <!-- ICONO -->
                        <Label Text="🔐"
                               FontSize="42"
                               HorizontalOptions="Center"/>

                        <Label Text="Iniciar sesión"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{StaticResource VerdePrincipal}"
                               HorizontalOptions="Center"/>

                        <Label Text="Ingresa tus credenciales para continuar"
                               FontSize="13"
                               TextColor="#718078"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>

                        <BoxView HeightRequest="1"
                                 Color="#E3EBE5"
                                 Margin="5,0"/>

                        <!-- USUARIO -->
                        <VerticalStackLayout Spacing="8">

                            <Label Text="Correo electrónico"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextoOscuro}"/>

                            <Border BackgroundColor="#F3F8F4"
                                    Stroke="#DCE9DF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="12,2">

                                <Entry x:Name="UsuarioEntry"
                                       Placeholder="Ingresa tu correo"
                                       Keyboard="Email"
                                       MaxLength="20"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource TextoOscuro}"
                                       PlaceholderColor="#94A49A"
                                       ClearButtonVisibility="WhileEditing"/>

                            </Border>

                        </VerticalStackLayout>

                        <!-- CONTRASEÑA -->
                        <VerticalStackLayout Spacing="8">

                            <Label Text="Contraseña"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextoOscuro}"/>

                            <Border BackgroundColor="#F3F8F4"
                                    Stroke="#DCE9DF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="12,2">

                                <Entry x:Name="ContrasenaEntry"
                                       Placeholder="Ingresa tu contraseña"
                                       Keyboard="Password"
                                       IsPassword="True"
                                       MaxLength="15"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource TextoOscuro}"
                                       PlaceholderColor="#94A49A"/>

                            </Border>

                        </VerticalStackLayout>

                        <!-- INGRESAR -->
                        <Button Text="Ingresar  →"
                                BackgroundColor="{StaticResource VerdePrincipal}"
                                TextColor="White"
                                FontSize="16"
                                FontAttributes="Bold"
                                CornerRadius="15"
                                HeightRequest="56"
                                Clicked="OnIngresarClicked"/>

                        <!-- REGRESAR -->
                        <Button Text="← Regresar"
                                BackgroundColor="#E5F3E9"
                                TextColor="{StaticResource VerdeOscuro}"
                                FontSize="15"
                                FontAttributes="Bold"
                                CornerRadius="15"
                                HeightRequest="52"
                                Clicked="OnRegresarLoginClicked"/>

                        <Label Text="Tu seguridad y confianza son nuestra prioridad."
                               FontSize="11"
                               TextColor="#91A096"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,5,0,0"/>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

        <!-- PIE DE PAGINA -->
        <Grid Grid.Row="1"
              BackgroundColor="{StaticResource VerdeOscuro}"
              Padding="15,12">

            <Label Text="© 2026 Cooperativa | Todos los derechos reservados"
                   FontSize="10"
                   TextColor="#D8EFE1"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>

        </Grid>

    </Grid>

</ContentPage>
