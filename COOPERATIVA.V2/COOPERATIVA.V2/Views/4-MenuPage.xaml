<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Menú principal"
             x:Class="COOPERATIVA.V2.Views.MenuPage">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Cerrar sesión"
            Order="Primary"
            Priority="0"
            Clicked="OnCerrarSesionClicked"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="Cooperativa"
                FontSize="40"
                FontAttributes="Bold"
                HorizontalOptions="Center"  
                TextColor="DarkGreen"/>

            <Label
                Text="Bienvenido al sistema"
                HorizontalOptions="Center"
                FontSize="17"/>

            <Button
                Text="👥  Socios"
                FontAttributes="Bold"
                FontSize="Large"
                HeightRequest="65"
                BackgroundColor="DarkBlue"
                TextColor="White"
                Clicked="OnSociosClicked"/>

            <Button
                Text="💰  Ahorros"
                FontAttributes="Bold"
                FontSize="Large"
                HeightRequest="65"
                BackgroundColor="DarkGreen"
                TextColor="White"
                Clicked="OnAhorrosClicked"/>

            <Button
                Text="🤝  Préstamos"
                FontAttributes="Bold"
                FontSize="Large"
                HeightRequest="65"
                BackgroundColor="DarkOrange"
                TextColor="White"
                Clicked="OnPrestamosClicked"/>

            <Button
                Text="💳  Pagos"
                FontAttributes="Bold"
                FontSize="Large"
                HeightRequest="65"
                BackgroundColor="Purple"
                TextColor="White"
                Clicked="OnPagosClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>