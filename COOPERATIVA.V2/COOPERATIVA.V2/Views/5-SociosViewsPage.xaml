<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Socios"
             x:Class="COOPERATIVA.V2.Views.SociosViewsPage">
    
    
    <Grid RowDefinitions="Auto,*,Auto"
          Padding="18"
          RowSpacing="12">

        <!-- Encabezado -->
        <VerticalStackLayout Grid.Row="0" Spacing="5">
            <Label
                Text="Gestión de socios"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="Blue"/>

            <Label
                Text="Registra y consulta los miembros"
                FontSize="14"
                TextColor="Gray"/>

            <SearchBar
                x:Name="BuscarSocio"
                Placeholder="Buscar por nombre o cédula..."
                BackgroundColor="White"/>
        </VerticalStackLayout>

        <!-- Lista de socios -->
        <CollectionView
            Grid.Row="1"
            x:Name="ListaSocios"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="20"
                    Spacing="8"
                    VerticalOptions="Center">

                    <Label
                        Text="No hay socios registrados"
                        FontSize="18"
                        HorizontalOptions="Center"/>

                    <Label
                        Text="Utiliza el botón Nuevo socio para comenzar."
                        HorizontalTextAlignment="Center"
                        TextColor="Gray"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        BackgroundColor="White"
                        Stroke="#D8E6F5"
                        StrokeThickness="1"
                        Padding="12"
                        Margin="0,4"
                        StrokeShape="RoundRectangle 12">

                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="10">

                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="{Binding NombreCompleto}"
                                FontAttributes="Bold"
                                FontSize="16"
                                TextColor="RoyalBlue"/>

                            <Label
                                Grid.Row="1"
                                Text="{Binding Cedula}"
                                FontSize="13"
                                TextColor="Gray"/>

                            <Label
                                Grid.Row="2"
                                Text="{Binding Telefono}"
                                FontSize="13"/>

                            <Label
                                Grid.Column="1"
                                Grid.RowSpan="3"
                                Text="{Binding Estado}"
                                TextColor="#168344"
                                VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Acciones -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              ColumnSpacing="10">

            <Button
                Grid.Column="0"
                Text="+ Nuevo socio"
                BackgroundColor="Blue"
                TextColor="White"
                CornerRadius="10"
                Clicked="OnNuevoSocioClicked"/>

            <Button
                Grid.Column="1"
                Text="Editar / consultar"
                BackgroundColor="DarkGreen"
                TextColor="White"
                CornerRadius="10"
                Clicked="OnEditarSocioClicked"/>
        </Grid>
    </Grid>
</ContentPage>