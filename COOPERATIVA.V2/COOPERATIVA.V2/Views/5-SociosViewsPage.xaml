<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Socios"
             x:Class="COOPERATIVA.V2.Views.SociosViewsPage"
             BackgroundColor="#F3F8F4"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <Color x:Key="VerdePrincipal">#087443</Color>
        <Color x:Key="VerdeOscuro">#064D32</Color>
        <Color x:Key="VerdeClaro">#E3F3E9</Color>
        <Color x:Key="TextoOscuro">#183B2B</Color>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto"
          RowSpacing="0">

        <!-- ENCABEZADO -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource VerdeOscuro}"
              Padding="22,25,22,28">

            <VerticalStackLayout Spacing="8">

                <Label Text="PANEL DE ADMINISTRACIÓN"
                       FontSize="11"
                       CharacterSpacing="2"
                       FontAttributes="Bold"
                       TextColor="#B9E5CC"/>

                <Label Text="Gestión de socios"
                       FontSize="29"
                       FontAttributes="Bold"
                       TextColor="White"/>

                <Label Text="Registra, consulta y administra los miembros de la cooperativa."
                       FontSize="13"
                       TextColor="#D8EFE1"/>

            </VerticalStackLayout>
        </Grid>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Row="1"
              RowDefinitions="Auto,*"
              Padding="18,18,18,8"
              RowSpacing="15">

            <!-- BUSCADOR -->
            <Border Grid.Row="0"
                    BackgroundColor="White"
                    Stroke="#DCE9DF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="12,2">

                <SearchBar x:Name="BuscarSocio"
                           Placeholder="Buscar por nombre o cédula..."
                           BackgroundColor="White"
                           TextColor="#183B2B"
                           PlaceholderColor="#8A9B90"
                           CancelButtonColor="#087443"/>
            </Border>

            <!-- LISTA DE SOCIOS -->
            <CollectionView Grid.Row="1"
                            x:Name="ListaSocios"
                            SelectionMode="None"
                            VerticalScrollBarVisibility="Never">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="25"
                                         Spacing="10"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center">

                        <Border BackgroundColor="#E3F3E9"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 25"
                                WidthRequest="85"
                                HeightRequest="85"
                                HorizontalOptions="Center">

                            <Label Text="👥"
                                   FontSize="42"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                        <Label Text="No hay socios registrados"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#183B2B"
                               HorizontalOptions="Center"/>

                        <Label Text="Utiliza el botón Nuevo socio para comenzar."
                               FontSize="13"
                               TextColor="#718078"
                               HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border BackgroundColor="White"
                                Stroke="#DCE9DF"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="15"
                                Margin="0,4,0,8">

                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="7">

                                <!-- NOMBRE -->
                                <Label Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding NombreCompleto}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="#064D32"
                                       VerticalOptions="Center"/>

                                <!-- CEDULA -->
                                <HorizontalStackLayout Grid.Row="1"
                                                       Grid.Column="0"
                                                       Spacing="7">

                                    <Label Text="Cédula:"
                                           FontSize="12"
                                           TextColor="#718078"/>

                                    <Label Text="{Binding Cedula}"
                                           FontSize="12"
                                           TextColor="#183B2B"/>

                                </HorizontalStackLayout>

                                <!-- TELEFONO -->
                                <HorizontalStackLayout Grid.Row="2"
                                                       Grid.Column="0"
                                                       Spacing="7">

                                    <Label Text="Teléfono:"
                                           FontSize="12"
                                           TextColor="#718078"/>

                                    <Label Text="{Binding Telefono}"
                                           FontSize="12"
                                           TextColor="#183B2B"/>

                                </HorizontalStackLayout>

                                <!-- ESTADO -->
                                <Border Grid.Column="1"
                                        Grid.RowSpan="3"
                                        BackgroundColor="#E3F3E9"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="10,6"
                                        VerticalOptions="Center">

                                    <Label Text="{Binding Estado}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="#087443"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center"/>

                                </Border>

                            </Grid>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </Grid>

        <!-- BOTONES DE ACCIONES -->
        <Grid Grid.Row="2"
              BackgroundColor="White"
              Padding="16,12"
              ColumnDefinitions="*,*"
              ColumnSpacing="12">

            <Button Grid.Column="0"
                    Text="+ Nuevo socio"
                    BackgroundColor="#087443"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="13"
                    CornerRadius="13"
                    HeightRequest="50"
                    Clicked="OnNuevoSocioClicked"/>

            <Button Grid.Column="1"
                    Text="Editar / consultar"
                    BackgroundColor="#064D32"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="13"
                    CornerRadius="13"
                    HeightRequest="50"
                    Clicked="OnEditarSocioClicked"/>

        </Grid>

    </Grid>
</ContentPage>
