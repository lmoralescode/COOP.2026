<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="COOPERATIVA.V2.Views.LoginViewsPage"
             Title="LoginViewsPage">
    <VerticalStackLayout>

        <Label Margin="50"
               Text="Login"
               TextColor="DarkGreen"
               FontSize="40"
               FontAttributes="Bold"
               VerticalOptions="Center" 
               HorizontalOptions="Center" />

        <StackLayout>

            <Entry Margin="10"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   HeightRequest="20"
                   WidthRequest="250"
                   Placeholder="Usuario"
                   TextColor="White"
                   FontAttributes="Bold"
                   BackgroundColor="DarkGreen">
            </Entry>

            <Entry Margin="10"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   HeightRequest="50"
                   WidthRequest="250"
                   Placeholder="Clave"
                   TextColor="White"
                   FontAttributes="Bold"
                   BackgroundColor="DarkGreen">
            </Entry>

        </StackLayout>
    </VerticalStackLayout>
</ContentPage>