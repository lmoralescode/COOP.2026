<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Préstamos"
             x:Class="COOPERATIVA.V2.Views.PrestamosViewsPage"
             BackgroundColor="#F3F8F4"
             Shell.NavBarIsVisible="False"
             Shell.BackgroundColor="#064D32"
             Shell.ForegroundColor="White"
             Shell.TitleColor="White"
             NavigationPage.HasNavigationBar="False"
             NavigationPage.HasBackButton="False">

    <ContentPage.Resources>
        <Color x:Key="VerdePrincipal">#087443</Color>
        <Color x:Key="VerdeOscuro">#064D32</Color>
        <Color x:Key="VerdeClaro">#E3F3E9</Color>
        <Color x:Key="TextoOscuro">#183B2B</Color>
    </ContentPage.Resources>

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Spacing="18">

            <!-- ENCABEZADO -->
            <Grid BackgroundColor="{StaticResource VerdeOscuro}"
                  Padding="22,22,22,32">

                <VerticalStackLayout Spacing="8">

                    <Label Text="PANEL FINANCIERO"
                           FontSize="11"
                           CharacterSpacing="2"
                           FontAttributes="Bold"
                           TextColor="#B9E5CC"/>

                    <Label Text="Gestión de préstamos"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="White"/>

                    <Label Text="Administra las solicitudes y financiamientos de los socios."
                           FontSize="13"
                           TextColor="#D8EFE1"/>

                </VerticalStackLayout>
            </Grid>

            <!-- CONTENIDO -->
            <VerticalStackLayout
                Margin="18,-15,18,25"
                Spacing="17">

                <!-- DATOS DEL PRESTAMO -->
                <Border BackgroundColor="White"
                        Stroke="#DCE9DF"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="17">

                    <VerticalStackLayout Spacing="13">

                        <Label Text="Nueva solicitud"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource VerdeOscuro}"/>

                        <Label Text="Socio solicitante"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextoOscuro}"/>

                        <Picker x:Name="SocioPrestamoPicker"
                                Title="Seleccione un socio"
                                BackgroundColor="#F3F8F4"
                                TextColor="#183B2B"
                                TitleColor="#718078"/>

                        <Label Text="Monto solicitado (RD$)"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextoOscuro}"/>

                        <Entry x:Name="MontoPrestamoEntry"
                               Placeholder="Ej. 30000"
                               PlaceholderColor="#8A9B90"
                               Keyboard="Numeric"
                               BackgroundColor="#F3F8F4"
                               TextColor="#183B2B"/>

                        <Label Text="Tasa de interés anual (%)"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextoOscuro}"/>

                        <Entry x:Name="TasaInteresEntry"
                               Placeholder="Ej. 12"
                               PlaceholderColor="#8A9B90"
                               Keyboard="Numeric"
                               BackgroundColor="#F3F8F4"
                               TextColor="#183B2B"/>

                        <Label Text="Plazo del préstamo"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextoOscuro}"/>

                        <Picker x:Name="PlazoPicker"
                                Title="Seleccione el plazo"
                                BackgroundColor="#F3F8F4"
                                TextColor="#183B2B"
                                TitleColor="#718078">

                            <Picker.Items>
                                <x:String>6 meses</x:String>
                                <x:String>12 meses</x:String>
                                <x:String>18 meses</x:String>
                                <x:String>24 meses</x:String>
                                <x:String>36 meses</x:String>
                            </Picker.Items>

                        </Picker>

                        <Button Text="Calcular cuota estimada"
                                BackgroundColor="{StaticResource VerdePrincipal}"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="14"
                                HeightRequest="50"
                                CornerRadius="13"
                                Clicked="OnCalcularCuotaClicked"/>

                    </VerticalStackLayout>
                </Border>

                <!-- RESULTADO DE CUOTA -->
                <Border BackgroundColor="{StaticResource VerdeOscuro}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        Padding="20">

                    <VerticalStackLayout Spacing="10">

                        <Label Text="RESUMEN DEL PRÉSTAMO"
                               FontSize="11"
                               CharacterSpacing="1.5"
                               FontAttributes="Bold"
                               TextColor="#B9E5CC"/>

                        <Label Text="Cuota mensual estimada"
                               FontSize="15"
                               TextColor="#D8EFE1"/>

                        <Label x:Name="CuotaLabel"
                               Text="RD$ 0.00"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="White"/>

                        <BoxView HeightRequest="1"
                                 Color="#438365"
                                 Margin="0,4"/>

                        <Label x:Name="ResumenPrestamoLabel"
                               Text="Complete los datos para calcular."
                               FontSize="13"
                               TextColor="#D8EFE1"/>

                    </VerticalStackLayout>
                </Border>

                <!-- REGISTRAR SOLICITUD -->
                <Button Text="Registrar solicitud"
                        BackgroundColor="#087443"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="15"
                        HeightRequest="52"
                        CornerRadius="13"
                        Clicked="OnRegistrarPrestamoClicked"/>

                <!-- HISTORIAL -->
                <VerticalStackLayout Spacing="4">

                    <Label Text="Préstamos registrados"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextoOscuro}"/>

                    <Label Text="Consulta las solicitudes registradas."
                           FontSize="12"
                           TextColor="#718078"/>

                </VerticalStackLayout>

                <CollectionView x:Name="ListaPrestamos"
                                HeightRequest="300"
                                SelectionMode="None"
                                VerticalScrollBarVisibility="Never">

                    <CollectionView.EmptyView>

                        <Border BackgroundColor="White"
                                Stroke="#DCE9DF"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="20">

                            <VerticalStackLayout Spacing="8"
                                                 HorizontalOptions="Center">

                                <Label Text="📋"
                                       FontSize="35"
                                       HorizontalOptions="Center"/>

                                <Label Text="No hay préstamos registrados."
                                       FontSize="14"
                                       TextColor="#718078"
                                       HorizontalTextAlignment="Center"/>

                            </VerticalStackLayout>

                        </Border>

                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border BackgroundColor="White"
                                    Stroke="#DCE9DF"
                                    StrokeThickness="1"
                                    Padding="15"
                                    Margin="0,3,0,8"
                                    StrokeShape="RoundRectangle 17">

                                <VerticalStackLayout Spacing="8">

                                    <Label Text="{Binding NumeroPrestamo}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           TextColor="{StaticResource VerdeOscuro}"/>

                                    <Label Text="{Binding Monto, StringFormat='Monto: RD$ {0:N2}'}"
                                           FontSize="13"
                                           TextColor="#183B2B"/>

                                    <Label Text="{Binding SaldoPendiente, StringFormat='Saldo pendiente: RD$ {0:N2}'}"
                                           FontSize="13"
                                           TextColor="#183B2B"/>

                                    <Border BackgroundColor="#E3F3E9"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            Padding="9,5"
                                            HorizontalOptions="Start">

                                        <Label Text="{Binding Estado}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#087443"/>

                                    </Border>

                                </VerticalStackLayout>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
