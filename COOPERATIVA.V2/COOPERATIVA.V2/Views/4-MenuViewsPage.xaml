<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
             x:Class="COOPERATIVA.V2.MenuViewsPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="Cooperativa"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#064A9B"/>

            <Label
                Text="Bienvenido al sistema"
                FontSize="17"/>

            <Button
                Text="👥  Socios"
                HeightRequest="65"
                BackgroundColor="#0759B5"
                TextColor="White"/>
            <!--Clicked="OnSociosClicked"/>-->

            <Button
                Text="💰  Ahorros"
                HeightRequest="65"
                BackgroundColor="#159447"
                TextColor="White"/>
            <!--Clicked="OnAhorrosClicked"/>-->

            <Button
                Text="🤝  Préstamos"
                HeightRequest="65"
                BackgroundColor="#E99519"
                TextColor="White"/>
            <!--Clicked="OnPrestamosClicked"/>-->

            <Button
                Text="💳  Pagos"
                HeightRequest="65"
                BackgroundColor="#7046C8"
                TextColor="White"/>
            <!--Clicked="OnPagosClicked"/>-->

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>