<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="COOPERATIVA.V2.Views.PagosViewsPage">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14">

            <Label
                Text="Pagos y cuotas"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="Blue"/>

            <Label Text="Seleccionar préstamo"/>

            <Picker
                x:Name="PrestamoPicker"
                Title="Seleccione un préstamo"
                BackgroundColor="White"/>

            <Border
                BackgroundColor="White"
                Stroke="WhiteSmoke"
                Padding="15"
                StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="Resumen del préstamo"
                        FontAttributes="Bold"
                        FontSize="18"
                        TextColor="Blue"/>

                    <Label
                        x:Name="NumeroPrestamoLabel"
                        Text="Préstamo: --"/>

                    <Label
                        x:Name="SaldoPendienteLabel"
                        Text="Saldo pendiente: RD$ 0.00"/>

                    <Label
                        x:Name="EstadoPrestamoLabel"
                        Text="Estado: Sin seleccionar"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Número de cuota"/>

            <Entry
                x:Name="NumeroCuotaEntry"
                Placeholder="Ej. 1"
                Keyboard="Numeric"
                BackgroundColor="White"/>

            <Label Text="Monto pagado (RD$)"/>

            <Entry
                x:Name="MontoPagoEntry"
                Placeholder="0.00"
                Keyboard="Numeric"
                BackgroundColor="White"/>

            <Label Text="Fecha de pago"/>

            <DatePicker
                x:Name="FechaPagoPicker"
                Format="dd/MM/yyyy"
                BackgroundColor="White"/>

            <Button
                Text="Registrar pago"
                BackgroundColor="Blue"
                TextColor="White"
                HeightRequest="50"
                CornerRadius="10"/>
            <!--Clicked="OnRegistrarPagoClicked"/>-->

            <Label
                Text="Historial de pagos"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="Blue"
                Margin="0,10,0,0"/>

            <CollectionView
                x:Name="ListaPagos"
                HeightRequest="280"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <Label
                        Text="No hay pagos registrados."
                        TextColor="Gray"
                        Padding="10"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            BackgroundColor="White"
                            Stroke="WhiteSmoke"
                            Padding="12"
                            Margin="0,3"
                            StrokeShape="RoundRectangle 10">

                            <Grid
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto">

                                <Label
                                    Text="{Binding NumeroCuota, StringFormat='Cuota: {0}'}"
                                    FontAttributes="Bold"
                                    TextColor="Blue"/>

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Monto, StringFormat='RD$ {0:N2}'}"
                                    FontAttributes="Bold"/>

                                <Label
                                    Grid.Row="1"
                                    Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}"
                                    FontSize="12"
                                    TextColor="Gray"/>

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding Estado}"
                                    FontSize="12"
                                    TextColor="DarkGreen"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>