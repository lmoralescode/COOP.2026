<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="COOPERATIVA.V2.Views.InicioViewsPage"
             BackgroundColor="#F3F8F4"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>

        <Color x:Key="VerdePrincipal">#087443</Color>
        <Color x:Key="VerdeOscuro">#064D32</Color>
        <Color x:Key="VerdeClaro">#E3F3E9</Color>
        <Color x:Key="TextoOscuro">#183B2B</Color>

        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="HeightRequest" Value="58"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="White"/>
        </Style>

    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">

            <VerticalStackLayout Spacing="0">

                <!-- ENCABEZADO VERDE -->
                <Grid BackgroundColor="{StaticResource VerdeOscuro}"
                      Padding="25,35,25,65">

                    <VerticalStackLayout Spacing="12">

                        <Label Text="BIENVENIDO A"
                               FontSize="13"
                               CharacterSpacing="3"
                               TextColor="#B9E5CC"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>

                        <Label Text="TU COOPERATIVA"
                               FontSize="27"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"/>

                        <Label Text="Construimos juntos un futuro mejor"
                               FontSize="14"
                               TextColor="#D8EFE1"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>

                </Grid>

                <!-- CONTENIDO PRINCIPAL -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 28"
                        Margin="20,-40,20,0"
                        Padding="20">

                    <VerticalStackLayout Spacing="17">

                        <!-- LOGO -->
                        <Border BackgroundColor="#F0F8F2"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 22"
                                Padding="12">

                            <Image Source="logocoopv2.png"
                                   HeightRequest="155"
                                   WidthRequest="250"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"/>

                        </Border>

                        <!-- TITULO -->
                        <Label Text="🤝"
                               FontSize="42"
                               HorizontalOptions="Center"/>

                        <Label Text="Cooperativa"
                               FontSize="30"
                               FontAttributes="Bold"
                               TextColor="{StaticResource VerdePrincipal}"
                               HorizontalOptions="Center"/>

                        <Label Text="Juntos por un mejor futuro"
                               FontSize="16"
                               TextColor="#64756A"
                               HorizontalOptions="Center"/>

                        <BoxView HeightRequest="1"
                                 Color="#E3EBE5"
                                 Margin="10,5"/>

                        <!-- MENSAJE -->
                        <VerticalStackLayout Spacing="8">

                            <Label Text="Tu esfuerzo,"
                                   FontSize="23"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextoOscuro}"
                                   HorizontalOptions="Center"/>

                            <Label Text="nuestra mayor riqueza."
                                   FontSize="23"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource VerdePrincipal}"
                                   HorizontalOptions="Center"/>

                            <Label Text="Crece, ahorra y alcanza tus metas con nosotros."
                                   FontSize="14"
                                   TextColor="#718078"
                                   HorizontalTextAlignment="Center"
                                   Margin="5,5,5,5"/>

                        </VerticalStackLayout>

                        <!-- BOTONES -->
                        <Button Text="Comenzar  →"
                                BackgroundColor="{StaticResource VerdePrincipal}"
                                Clicked="OnComenzarClicked"/>

                        <Button Text="Registrarme"
                                BackgroundColor="#E5F3E9"
                                TextColor="{StaticResource VerdeOscuro}"
                                BorderColor="#B9DCC5"
                                BorderWidth="1"
                                Clicked="OnRegistroClicked"/>

                        <Label Text="Tu futuro comienza hoy."
                               FontSize="12"
                               TextColor="#91A096"
                               HorizontalOptions="Center"
                               Margin="0,5,0,0"/>

                    </VerticalStackLayout>

                </Border>

                <Label Text="SEGURIDAD • CONFIANZA • CRECIMIENTO"
                       FontSize="10"
                       CharacterSpacing="1"
                       TextColor="#82958A"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="15,20,15,25"/>

            </VerticalStackLayout>

        </ScrollView>

        <!-- PIE DE PÁGINA -->
        <Grid Grid.Row="1"
              BackgroundColor="{StaticResource VerdeOscuro}"
              Padding="15,12">

            <Label Text="© 2026 Cooperativa | Todos los derechos reservados"
                   FontSize="10"
                   TextColor="#D8EFE1"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>

        </Grid>

    </Grid>

</ContentPage>
