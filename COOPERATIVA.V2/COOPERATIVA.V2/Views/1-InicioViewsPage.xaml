<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="COOPERATIVA.V2.Views.InicioViewsPage"
             BackgroundColor="White">

    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="DarkGreen"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout
            Padding="25"
            Spacing="5"
            VerticalOptions="Center">
            
            <Image Source="logocoopv2.png"
                   HeightRequest="300"
                   WidthRequest="800"
                   Aspect="AspectFit"
                   VerticalOptions="Center"
                   HorizontalOptions="Center" />

            <Label
                Text="🤝"
                FontSize="70"
                HorizontalOptions="Center"/>

            <Label
                Text="Cooperativa"
                FontSize="32"
                FontAttributes="Bold"
                TextColor="DarkGreen"
                HorizontalOptions="Center"/>

            <Label
                Text="Juntos por un mejor futuro"
                FontSize="16"
                HorizontalOptions="Center"/>

            <Label
                Text="Tu esfuerzo, nuestra mayor riqueza"
                FontSize="20"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Margin="0,25,0,20"/>

            <Button
                Text="Comenzar"
                TextColor="White"
                FontSize="Medium"
                CornerRadius="5"
                HeightRequest="55"
                WidthRequest="250"
                Clicked="OnComenzarClicked"/>

            <Button
                Text="Registrarme"
                TextColor="White"
                FontSize="Medium"
                CornerRadius="5"
                HeightRequest="55"
                WidthRequest="250"
                Clicked="OnRegistroClicked"/>


        </VerticalStackLayout>
    </ScrollView>
</ContentPage>