<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="COOPERATIVA.V2.Views.RegistroViewsPage"
             Title="{Binding TituloFormulario}"
             BackgroundColor="#F3F8F4"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>

        <Color x:Key="VerdePrincipal">#087443</Color>
        <Color x:Key="VerdeOscuro">#064D32</Color>
        <Color x:Key="VerdeClaro">#E3F3E9</Color>
        <Color x:Key="TextoOscuro">#183B2B</Color>

        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor" Value="#183B2B"/>
            <Setter Property="PlaceholderColor" Value="#94A49A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HeightRequest" Value="48"/>
        </Style>

        <Style TargetType="Label"
               x:Key="CampoLabel">
            <Setter Property="TextColor" Value="#183B2B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontAttributes" Value="Bold"/>
        </Style>

        <Style TargetType="Label"
               x:Key="ErrorStyle">
            <Setter Property="TextColor" Value="#D93636"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="5,0,0,2"/>
        </Style>

    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">

            <VerticalStackLayout Spacing="0">

                <!-- ENCABEZADO -->
                <Grid BackgroundColor="{StaticResource VerdeOscuro}"
                      Padding="22,30,22,65">

                    <VerticalStackLayout Spacing="9">

                        <Label Text="GESTIÓN DE SOCIOS"
                               FontSize="12"
                               CharacterSpacing="3"
                               FontAttributes="Bold"
                               TextColor="#B9E5CC"
                               HorizontalOptions="Center"/>

                        <Label Text="{Binding TituloFormulario}"
                               FontSize="27"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"/>

                        <Label Text="Información y datos del miembro"
                               FontSize="14"
                               TextColor="#D8EFE1"
                               HorizontalOptions="Center"/>

                    </VerticalStackLayout>

                </Grid>

                <!-- FORMULARIO -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 26"
                        Margin="16,-40,16,20"
                        Padding="20">

                    <VerticalStackLayout Spacing="15">

                        <!-- ICONO -->
                        <Border BackgroundColor="#E5F3E9"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 50"
                                WidthRequest="75"
                                HeightRequest="75"
                                HorizontalOptions="Center">

                            <Label Text="👤"
                                   FontSize="37"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>

                        </Border>

                        <Label Text="Datos personales"
                               FontSize="21"
                               FontAttributes="Bold"
                               TextColor="{StaticResource VerdePrincipal}"
                               HorizontalOptions="Center"/>

                        <Label Text="Complete los campos para registrar la información del socio."
                               FontSize="13"
                               TextColor="#718078"
                               HorizontalTextAlignment="Center"/>

                        <BoxView HeightRequest="1"
                                 Color="#E3EBE5"/>

                        <!-- NOMBRE -->
                        <Label Text="Nombre"
                               Style="{StaticResource CampoLabel}"/>

                        <Border BackgroundColor="#F3F8F4"
                                Stroke="#DCE9DF"
                                StrokeShape="RoundRectangle 12"
                                Padding="10,0">

                            <Entry x:Name="NombreEntry"
                                   Placeholder="Ingrese el nombre"
                                   Keyboard="Text"
                                   MaxLength="20"
                                   Text="{Binding Nombre}"/>

                        </Border>

                        <Label Text="{Binding ErrorNombre}"
                               Style="{StaticResource ErrorStyle}"/>

                        <!-- APELLIDOS -->
                        <Label Text="Apellidos"
                               Style="{StaticResource CampoLabel}"/>

                        <Border BackgroundColor="#F3F8F4"
                                Stroke="#DCE9DF"
                                StrokeShape="RoundRectangle 12"
                                Padding="10,0">

                            <Entry x:Name="ApellidosEntry"
                                   Placeholder="Ingrese los apellidos"
                                   Keyboard="Text"
                                   MaxLength="30"
                                   Text="{Binding Apellidos}"/>

                        </Border>

                        <Label Text="{Binding ErrorApellidos}"
                               Style="{StaticResource ErrorStyle}"/>

                        <!-- CEDULA -->
                        <Label Text="Cédula de identidad"
                               Style="{StaticResource CampoLabel}"/>

                        <Border BackgroundColor="#F3F8F4"
                                Stroke="#DCE9DF"
                                StrokeShape="RoundRectangle 12"
                                Padding="10,0">

                            <Entry x:Name="CedulaEntry"
                                   Placeholder="00000000000"
                                   Keyboard="Numeric"
                                   MaxLength="11"
                                   Text="{Binding Cedula}"/>

                        </Border>

                        <Label Text="{Binding ErrorCedula}"
                               Style="{StaticResource ErrorStyle}"/>

                        <!-- TELEFONO -->
                        <Label Text="Teléfono"
                               Style="{StaticResource CampoLabel}"/>

                        <Border BackgroundColor="#F3F8F4"
                                Stroke="#DCE9DF"
                                StrokeShape="RoundRectangle 12"
                                Padding="10,0">

                            <Entry x:Name="TelefonoEntry"
                                   Placeholder="8090000000"
                                   Keyboard="Telephone"
                                   MaxLength="10"
                                   Text="{Binding Telefono}"/>

                        </Border>

                        <Label Text="{Binding ErrorTelefono}"
                               Style="{StaticResource ErrorStyle}"/>

                        <!-- DIRECCION -->
                        <Label Text="Dirección"
                               Style="{StaticResource CampoLabel}"/>

                        <Border BackgroundColor="#F3F8F4"
                                Stroke="#DCE9DF"
                                StrokeShape="RoundRectangle 12"
                                Padding="10,0">

                            <Entry x:Name="DireccionEntry"
                                   Placeholder="Ingrese la dirección"
                                   Keyboard="Text"
                                   MaxLength="50"
                                   Text="{Binding Direccion}"/>

                        </Border>

                        <!-- FECHA -->
                        <Label Text="Fecha de nacimiento"
                               Style="{StaticResource CampoLabel}"/>

                        <Border BackgroundColor="#F3F8F4"
                                Stroke="#DCE9DF"
                                StrokeShape="RoundRectangle 12"
                                Padding="10">

                            <DatePicker x:Name="FechaNacimientoPicker"
                                        Date="{Binding FechaNacimiento}"
                                        Format="dd/MM/yyyy"
                                        TextColor="{StaticResource TextoOscuro}"/>

                        </Border>

                        <!-- CORREO -->
                        <Label Text="Correo electrónico"
                               Style="{StaticResource CampoLabel}"/>

                        <Border BackgroundColor="#F3F8F4"
                                Stroke="#DCE9DF"
                                StrokeShape="RoundRectangle 12"
                                Padding="10,0">

                            <Entry x:Name="CorreoEntry"
                                   Placeholder="correo@ejemplo.com"
                                   Keyboard="Email"
                                   MaxLength="100"
                                   Text="{Binding Correo}"/>

                        </Border>

                        <Label Text="{Binding ErrorCorreo}"
                               Style="{StaticResource ErrorStyle}"/>

                        <!-- CLAVE -->
                        <Label Text="Clave de acceso"
                               Style="{StaticResource CampoLabel}"/>

                        <Border BackgroundColor="#F3F8F4"
                                Stroke="#DCE9DF"
                                StrokeShape="RoundRectangle 12"
                                Padding="10,0">

                            <Entry x:Name="ClaveEntry"
                                   Placeholder="Mínimo 6 caracteres"
                                   IsPassword="True"
                                   Keyboard="Text"
                                   MaxLength="30"
                                   Text="{Binding Clave}"/>

                        </Border>

                        <Label Text="{Binding ErrorClave}"
                               Style="{StaticResource ErrorStyle}"/>

                        <BoxView HeightRequest="1"
                                 Color="#E3EBE5"
                                 Margin="0,5"/>

                        <!-- GUARDAR -->
                        <Button x:Name="GuardarButton"
                                Text="{Binding TextoBotonGuardar}"
                                Command="{Binding GuardarCommand}"
                                BackgroundColor="{StaticResource VerdePrincipal}"
                                TextColor="White"
                                FontSize="16"
                                FontAttributes="Bold"
                                CornerRadius="15"
                                HeightRequest="56"/>

                        <Label Text="🔒  Información protegida de nuestros socios"
                               FontSize="11"
                               TextColor="#82958A"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,5,0,0"/>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

        <!-- PIE DE PAGINA -->
        <Grid Grid.Row="1"
              BackgroundColor="{StaticResource VerdeOscuro}"
              Padding="15,12">

            <Label Text="© 2026 Cooperativa | Todos los derechos reservados"
                   FontSize="10"
                   TextColor="#D8EFE1"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>

        </Grid>

    </Grid>

</ContentPage>
