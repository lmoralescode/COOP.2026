<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="COOPERATIVA.V2.Views.RegistroViewsPage">

    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="DarkGreen"/>
        </Style>
        
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="12">

            <Label
                Text="Registro de socio"
                FontSize="27"
                FontAttributes="Bold"
                TextColor="DarkGreen"/>
            
            <Entry Placeholder="Nombre" Keyboard="Text" MaxLength="20" x:Name="NombreEntry"/>
            <Entry Placeholder="Apellidos" Keyboard="Text" MaxLength="30" x:Name="ApellidosEntry"/>
            <Entry Placeholder="Cédula de identidad" Keyboard="Numeric" MaxLength="11" x:Name="CedulaEntry"/>
            <Entry Placeholder="Teléfono" Keyboard="Telephone" MaxLength="10" x:Name="TelefonoEntry"/>
            <Entry Placeholder="Dirección" Keyboard="Text" MaxLength="50" x:Name="DireccionEntry"/>
            <DatePicker x:Name="FechaNacimientoPicker"/>

            <Entry
                Placeholder="Correo electrónico"
                Keyboard="Email"
                MaxLength="25"
                x:Name="CorreoEntry"/>

            <Entry
                Placeholder="Contraseña"
                IsPassword="True"
                MaxLength="12"
                x:Name="ContrasenaEntry"/>
    
            <Button
                Text="Registrar socio"
                TextColor="White"
                FontSize="Medium"/>

            <Button 
                Text="Limpiar campos"
                
                Clicked="OnLimpiarSocioClicked" />

            <Button Text="Cancelar"
                Clicked="OnCancelarSocioClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>